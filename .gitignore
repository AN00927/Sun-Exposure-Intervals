__pycache__/
*.pyc
*.egg-info/
dist/
build/
.pytest_cache/

# Virtualenvs
.venv/
venv/

# Editor / OS
.DS_Store
.idea/
.vscode/

# Bulk PDF full-text extracts: large, regenerable, and derived from the
